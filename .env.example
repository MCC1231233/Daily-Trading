# KIS Open API 자격증명. 이 파일을 복사해 .env 로 만들고 값을 채운다.
# .env 는 .gitignore 에 있다 — 절대 커밋하지 마라.
#
# 발급: https://apiportal.koreainvestment.com  →  로그인 → API 신청
#       모의투자 앱키와 실전 앱키는 별개다. 모의투자 계좌를 먼저 개설해야
#       모의 앱키가 나온다 (한국투자증권 홈 → 트레이딩 → 모의투자).

KIS_ENV=demo
KIS_APP_KEY=
KIS_APP_SECRET=
KIS_ACCOUNT=12345678-01

# 실계좌 전환 시에만. 이 값이 정확히 I_UNDERSTAND 여야 real 이 열린다.
# KIS_ALLOW_REAL=I_UNDERSTAND
